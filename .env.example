# USSA Lore Master Core — environment variables (Phase 1)
# Copy to .env and fill in real values. Never commit .env.

# --- Database (rootless PostgreSQL 16 + pgvector via micromamba env `ussa`) ---
DB_HOST=/tmp                 # unix socket dir (or host like 127.0.0.1)
DB_PORT=5433                 # port the local Postgres listens on
DB_USER=ussa                 # database role
DB_PASSWORD=                 # blank for local trust auth; set in prod
DB_NAME=ussa_lore            # database name

# --- API service ---
API_HOST=127.0.0.1           # bind address for the REST API
API_PORT=3000                # port the REST API listens on
API_TRADE_ROUTE_CACHE_TTL_SEC=15  # short TTL; trade routes are volatile
API_CATEGORIES_CACHE_TTL_SEC=300  # category index/counts are non-volatile; trade_route's own freshness always bypasses this
API_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2  # local embedding model (384-dim)

# --- Per-client API keys (bearer tokens) ---
# The API is internet-facing; anyone with a key can write data. Generate real
# random keys and keep them out of git. Only the sha256 hash is stored in the DB.
# Generate one with:  echo "wiki_$(openssl rand -hex 24)"
# The seed reads these; if unset it falls back to the well-known dev token
# (dev only). Set real values in .env for any public deployment.
WIKI_API_KEY=wiki_REPLACE_WITH_openssl_rand_hex_24
MOBILE_API_KEY=mobile_REPLACE_WITH_openssl_rand_hex_24
DESKTOP_API_KEY=desktop_REPLACE_WITH_openssl_rand_hex_24

# --- Scraper (later phase; UA declared now so we respect robots/ToS) ---
SCRAPER_USER_AGENT=USSALMC-Bot/0.1 (+respect-robots)
# max pages processed automatically per category batch after a template confirm
SCRAPER_BATCH_MAX_PAGES=50
# default variance threshold (% of expected template fields that may be
# missing/unmatched/structurally-different before a page is routed to the review
# queue instead of auto-processed). Per-category overrides set from the admin
# category management page take precedence; this is the fallback default.
SCRAPER_VARIANCE_THRESHOLD_PCT=40
# bulk-import (connector --force-overwrite) fetch budget — rolling windows,
# not calendar-day resets. Only applies to `npm run bulk-import`, not to
# ordinary scan/confirm/category-batch runs.
SCRAPER_BULK_IMPORT_RATE_PER_MIN=40
SCRAPER_BULK_IMPORT_RATE_PER_DAY=500

# --- Self-hosted entity images (Phase 18) ---
# We don't control starcitizen.tools/robertsspaceindustries.com, so every
# entity image is downloaded once (media-store.ts) and stored on disk instead
# of relying on the external URL forever. MEDIA_DIR is a filesystem path
# inside the api/admin containers (the docker-compose `ussalmc_media` volume
# mounts here in both, so admin can write what api serves). MEDIA_PUBLIC_BASE
# is the public origin used to build the URL stored in each entity's
# images[].url and to check idempotency on backfill re-runs — must match the
# domain that actually serves /media/* (api.ussa.space in production).
MEDIA_DIR=/app/media
MEDIA_PUBLIC_BASE=https://api.ussa.space

# --- Admin web tool (Phase 2 — scraper + review UI) ---
ADMIN_HOST=127.0.0.1         # bind address for the admin tool
ADMIN_PORT=4000              # port the admin tool listens on
# Admin is publicly reachable but LOGIN-GATED (DB-backed session login). Both
# required to bootstrap the initial account; on first login the admin is forced
# to change this password (dev credential). Use HTTPS in front of it in prod.
ADMIN_USER=angrypctech               # bootstrap admin login username
ADMIN_PASSWORD=change-me-please      # bootstrap admin password (forced change on 1st login)
# Bootstrap account is always role=super_admin. Setting its email to the same
# address as WORDPRESS_ADMIN_EMAIL lets the WordPress admin SSO straight into
# this account with no separate login prompt.
ADMIN_EMAIL=admin@ussa.space
COOKIE_SECURE=true                   # true once admin has an HTTPS vhost (admin.ussa.space); false only behind a plain-HTTP SSH tunnel
# Core API base the admin uses for the live wiki preview (proxied server-side
# with WIKI_API_KEY so the browser never sees the key). Compose overrides this
# to http://api:3000 in-container.
ADMIN_API_BASE=http://127.0.0.1:3000
# SSO handoff (wp-admin "USSA Admin" menu -> this admin tool). Shared secret
# must match the value the WordPress plugin uses (set via wp option
# ussalmc_sso_secret, seeded from this same var by wp-init.sh).
ADMIN_SSO_SECRET=REPLACE_WITH_openssl_rand_hex_32
# BROWSER-reachable admin app base (not the in-network docker name) — used
# both by this app's own links and by the WordPress SSO iframe src. MUST be a
# public HTTPS domain matching ussa.space's registrable domain: Chrome's
# Private Network Access policy blocks a public https:// page (wp-admin) from
# embedding a private-network iframe target (e.g. http://localhost:8091).
ADMIN_APP_PUBLIC_URL=https://admin.ussa.space
# rate limit for field confirm/flag signals submitted from the live wiki
WIKI_SIGNAL_RATE_LIMIT_PER_MIN=10

# --- Trade-route submission app (Phase 3 — web form + bot-style command) ---
TRADE_SUBMIT_HOST=127.0.0.1  # bind address for the submission app
TRADE_SUBMIT_PORT=5000       # port the submission app listens on
TRADE_SUBMIT_API_BASE=http://127.0.0.1:3000   # core API base it forwards to
TRADE_SUBMIT_API_KEY=wiki_REPLACE_WITH_SAME_AS_WIKI_API_KEY  # bearer key the submission app uses (match WIKI_API_KEY)
# submission-intelligence tuning (used by the core API's submit engine):
TRADE_CORROBORATION_WINDOW_MIN=120   # window in which matching reports corroborate
TRADE_PRICE_TOLERANCE=0.05           # +/- fraction for "matching" prices (5%)
TRADE_RATE_LIMIT_PER_MIN=5           # max submissions/min per reporting account
TRADE_MAX_PLAUSIBLE_PRICE=10000000   # per-unit price sanity ceiling (abuse flag)

# --- Discord bot (later phase) ---
DISCORD_BOT_TOKEN=           # discord.js bot token
DISCORD_API_KEY=discord_REPLACE_WITH_openssl_rand_hex_24  # this bot's USSALMC API bearer key

# --- Twitch bot (later phase) ---
TWITCH_BOT_TOKEN=            # tmi.js oauth token
TWITCH_API_KEY=twitch_REPLACE_WITH_openssl_rand_hex_24    # this bot's USSALMC API bearer key

# --- Docker / Docker Compose (Phase 4) ---
# When running under `docker compose up`, the compose file OVERRIDES DB_HOST=db,
# DB_PORT=5432, API_HOST/ADMIN_HOST=0.0.0.0 for the containers. These vars only
# matter for compose; the app code reads the same DB_*/API_*/ADMIN_* names.
#
# HOST port mappings (host:container) chosen to avoid 80/443/3306 (aaPanel):
#   db    -> host 55432 : container 5432
#   api   -> host 8090  : container 3000
#   admin -> host 8091  : container 4000
#
# In-container DB DSN (service name "db", NOT localhost). Provided for tools
# (e.g. a future ORM / WordPress plugin) that expect a single DATABASE_URL:
DATABASE_URL=postgresql://ussa@db:5432/ussa_lore   # points at the "db" service
SEED_ON_START=true          # api entrypoint seeds example data on first boot
TRUST_PROXY=true            # behind nginx/TLS proxy: trust X-Forwarded-* headers

# --- WordPress plugin/theme test instance (Docker Compose) -------------------
# A real, running WordPress used to develop/test the USSALMC plugins + theme.
# Private: published to 127.0.0.1:8093 only (reach via SSH tunnel), no public
# domain. Its own MariaDB (service `wordpress-db`), separate from the app
# Postgres. The `wordpress-cli` one-shot service auto-installs WP + Elementor
# using the vars below (idempotent — skips install if WP is already up).
WORDPRESS_DB_NAME=wordpress                 # WP database name (MariaDB)
WORDPRESS_DB_USER=wordpress                 # WP database user
WORDPRESS_DB_PASSWORD=REPLACE_WITH_openssl_rand_hex_24  # WP db password (generate: openssl rand -hex 24)
WORDPRESS_SITE_URL=http://localhost:8093    # site URL WP installs itself at (tunnel target)
WORDPRESS_SITE_TITLE=USSA Lore Master Core  # site title set at install
WORDPRESS_ADMIN_USER=admin                  # WP admin username (set at install)
WORDPRESS_ADMIN_PASSWORD=REPLACE_WITH_a_strong_password  # WP admin password (generate a strong one)
WORDPRESS_ADMIN_EMAIL=admin@ussa.space      # WP admin email
# Core API the wiki plugin reads (in-network service name); key = WIKI_API_KEY.
USSALMC_API_BASE=http://api:3000            # in-container core API base for the wiki plugin

# StarCitizen-API (https://starcitizen-api.com, unofficial fan project, unaffiliated
# with CIG/RSI) — used ONLY by the portal plugin's RSI-handle ownership verification
# (checks $.profile.bio for a registration token). Never used to fetch
# robertsspaceindustries.com directly (their ToS bars automated/bot access); this key
# is for the separate, ToS-permitted community API instead. Get one at
# starcitizen-api.com via Discord login. 1000 req/day in "live" mode. Server-side only.
STARCITIZEN_API_KEY=REPLACE_WITH_your_starcitizen-api.com_key

# Portal-only core API client key (separate from WIKI_API_KEY). Only this
# client is trusted to assert rsi_verified=true on trade submissions (see
# routes.ts) — keeps the RSI-verification-gated portal path distinguishable
# from the shared wiki key, which the anonymous trade-submit app also uses.
# Format matches every other client key: <client>_<48hex> (generate: openssl
# rand -hex 24).
PORTAL_API_KEY=portal_REPLACE_WITH_openssl_rand_hex_24

# --- OpenClaw MCP server (Phase 21) ---
# Backs apps/openclaw-mcp, a local MCP (Model Context Protocol) server that
# gives the user's own OpenClaw AI agent (running locally, e.g. via Ollama)
# real read-only tools over the knowledge base — one server/key, reused by
# every OpenClaw channel that agent is connected to (Discord, Twitch, ...)
# rather than a separate bot+key per channel. Never exposed to end users;
# the MCP server runs on the host (spawned by OpenClaw itself), not in Docker.
OPENCLAW_API_KEY=openclaw_REPLACE_WITH_openssl_rand_hex_24

# --- Instructional guides / YouTube ingestion (Phase 22) ---
# apps/admin/src/import-youtube-guide.ts fetches a YouTube video's transcript
# and uses a LOCAL LLM (via Ollama, never a hosted API) to extract a
# structured step-by-step guide entity (category 'guide') — never invents
# steps beyond what the transcript actually says (see docs/schema.md Phase
# 22). Runs on the host, same Ollama install already used by OpenClaw.
OLLAMA_BASE_URL=http://localhost:11434
GUIDE_EXTRACTION_MODEL=qwen3.6:35b-a3b

# UEX Corp (https://uexcorp.space, unofficial fan project, unaffiliated with
# CIG/RSI) — used by the portal's commodity price ticker
# ([ussalmc_ticker]). Get one at uexcorp.space/api/apps. Rate limit: 120/min,
# 172,800/day. Server-side only; polled server-side and cached
# (UEX_TICKER_CACHE_TTL, default 300s) so browser traffic never multiplies
# real upstream calls.
UEX_API_KEY=REPLACE_WITH_your_uexcorp.space_key
UEX_TICKER_CACHE_TTL=300
